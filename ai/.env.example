# AgentQ V5.5 — Environment Variables
# Copy this file to .env and fill in your values
# On Railway: set these in Project → Variables

# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
VNSTOCK_API_KEY=your_vnstock_api_key_here

# ── AI Shortlist (Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-3-flash-preview   # optional, this is the default

# ── Discord Channel IDs ───────────────────────────────────────────────────────
# Right-click channel in Discord → Copy Channel ID (requires Developer Mode)
SHORTLIST_CHANNEL_ID=1469331057999347889

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
TASK3_DB_URL=postgresql://user:password@host:5432/dbname

# ── Feature Flags ─────────────────────────────────────────────────────────────
TASK1_AI_ENABLED=1   # 1 = enable Gemini enrichment, 0 = disable

# ── Railway stable device ID (prevents KBS blocking on redeploy) ──────────────
VNSTOCK_DEVICE_SEED=agentq-railway-prod
