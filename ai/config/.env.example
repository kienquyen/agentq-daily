# AgentQ Configuration

# Required
DISCORD_TOKEN=your_discord_bot_token
VNSTOCK_API_KEY=your_vnstock_api_key

# Database (PostgreSQL recommended for production)
TASK3_DB_URL=postgresql://user:password@localhost:5432/agentq
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Cache
CACHE_ENABLED=1
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# AI Settings
GEMINI_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SEC=30

# Trading Constants
TRADING_DAYS=252
RF_ANNUAL=0.07
USDT_VND=26630

# Benchmark Symbols
BENCHMARK_SYMBOL_CANDIDATES=VNINDEX,VNI,VN-INDEX,^VNINDEX

# Feature Flags
TASK1_AI_ENABLED=1
DEBUG_AI=0

# Phase 6 — ML Shortlist (19:00 ICT daily)
SHORTLIST_CHANNEL_ID=your_discord_channel_id   # right-click channel → Copy ID
SHORTLIST_ENABLED=1                             # set to 0 to disable
