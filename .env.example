# Copy to .env for local dev. Set these as Railway env vars for cloud.

# Required: GitHub personal access token (repo scope)
# Used by scheduler to git push JSON updates to GitHub Pages
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Discord webhook for signal notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: vnstock API key (if using paid tier)
# VNSTOCK_API_KEY=xxx
